{
  "name": "archidemus.github.io",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gen:og": "bun run scripts/og.mjs",
    "format": "prettier --write \"src/**/*.{astro,tsx,ts,js,jsx,css,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{astro,tsx,ts,js,jsx,css,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\" \"vitest.config.ts\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "prettier --check \"src/**/*.{astro,tsx,ts,js,jsx,css,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\" \"vitest.config.ts\" && oxlint && astro check && astro build",
    "fix": "prettier --write \"src/**/*.{astro,tsx,ts,js,jsx,css,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\" \"vitest.config.ts\" && oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality:local": "oxlint && prettier --check \"src/**/*.{astro,tsx,ts,js,jsx,css,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\" \"vitest.config.ts\" && vitest run --coverage",
    "typecheck": "astro check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.2.1",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
