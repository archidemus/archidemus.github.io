{
  "name": "desktop-aiwalk",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gen:og": "bun run scripts/og.mjs",
    "format": "prettier --write \"src/**/*.{astro,tsx,ts,css,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{astro,tsx,ts,css,mjs}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "prettier --check \"src/**/*.{astro,tsx,ts,css,mjs}\" && oxlint && astro check && astro build",
    "fix": "prettier --write \"src/**/*.{astro,tsx,ts,css,mjs}\" && oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality:local": "oxlint && prettier --check \"src/**/*.{astro,tsx,ts,js,jsx,css,mjs}\" && vitest run --coverage",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^5.0.7",
    "@astrojs/tailwind": "^6.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^6.4.8",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^4.1.10"
  }
}
